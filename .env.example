# Producción en AWS EC2. El archivo .env real vive solo en el servidor y no se commitea.
# NODE_ENV=production
# PORT=3000
# DATABASE_URL=postgresql://USUARIO:CLAVE@tu-instancia.region.rds.amazonaws.com:5432/software_dental
# APP_PUBLIC_URL=https://www.mihistoriadental.com
# CORS_ORIGIN=https://www.mihistoriadental.com
# JWT_SECRET=
# KIOSK_JWT_SECRET=
# Vacío = Socket.IO usa el dominio de la página (recomendado detrás de nginx).
# VITE_SOCKET_URL=

# Credenciales de prueba del Mecanismo Único de Validación (MUV / FEV-RIPS).
# Copia este archivo como .env y completa los datos del prestador en el ambiente Stage:
#   cp .env.example .env

# Número de documento del usuario SISPRO. Obligatorio.
MINSALUD_USERNAME=

# Clave SISPRO del usuario. Obligatorio.
MINSALUD_PASSWORD=

# NIT del prestador, solo dígitos. Obligatorio.
MINSALUD_NIT=

# Tipo de documento del usuario. Ejemplo: CC, CE, PA, RC, TI, NV, CD, SC, PE, PT.
MINSALUD_TIPO_DOCUMENTO=CC

# MinsaludService envía siempre tipoUsuario PIN. Esta variable no cambia el login.
MINSALUD_TIPO_USUARIO=PIN

# Código REPS de la sede, 12 dígitos. Ejemplo: 6800103898-01 se escribe 680010389801.
MINSALUD_COD_PRESTADOR=680010389801

# Ruta a un XML de factura electrónica. Vacío: el script envía CargarRipsSinFactura.
MINSALUD_XML_FEV_PATH=

# stage sustituye el documento del paciente por el del prestador (RVG01 en pruebas).
# production envía el documento real del paciente.
MINSALUD_ENV=stage

# Tiempo máximo de cada llamada al MUV, en milisegundos. Rango 1000–180000. Default 45000.
MINSALUD_TIMEOUT_MS=45000

# Reintentos extra ante ENOTFOUND, ECONNRESET o ETIMEDOUT. 0 los apaga. Default 3.
MINSALUD_REINTENTOS=3
