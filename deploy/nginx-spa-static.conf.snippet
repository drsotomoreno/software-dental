# Fragmento Nginx: SPA estática desde dist/; Node solo /api/ y /socket.io/
# root y proxy_pass se rellenan por scripts/configure-nginx-spa-static.sh

# --- BEGIN MHD_SPA_STATIC ---
location /api/ {
    proxy_pass http://127.0.0.1:__PORT__;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
    client_max_body_size 150m;
}

location /socket.io/ {
    proxy_pass http://127.0.0.1:__PORT__;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
}

# Assets con hash: cache largo (immutable).
location /assets/ {
    root __DIST_ROOT__;
    access_log off;
    expires 30d;
    add_header Cache-Control "public, max-age=2592000, immutable" always;
    add_header X-MHD-Static "nginx-dist-assets" always;
    try_files $uri =404;
}

# HTML de entrada: NUNCA cachear (si no, el navegador queda en UI vieja / root vacío).
location = /index.html {
    root __DIST_ROOT__;
    add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    add_header X-MHD-Static "nginx-dist-html" always;
}

# Service Worker: NUNCA cachear (debe revalidar en cada visita).
location = /sw.js {
    root __DIST_ROOT__;
    add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    add_header X-MHD-Static "nginx-dist-sw" always;
    try_files $uri =404;
}

# Rutas SPA: servir index sin caché.
location / {
    root __DIST_ROOT__;
    try_files $uri $uri/ @mhd_spa;
    add_header X-MHD-Static "nginx-dist" always;
}

location @mhd_spa {
    root __DIST_ROOT__;
    add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    add_header X-MHD-Static "nginx-dist-spa" always;
    try_files /index.html =404;
}
# --- END MHD_SPA_STATIC ---
